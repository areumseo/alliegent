<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alliegent.update</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/work/alliegent/scripts/self_update.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/work/alliegent</string>

  <!-- __HOME__ is filled in by scripts/install_service.sh: launchd does not
       expand ~ or $HOME, and a hardcoded path names whoever set it up.
       Every 15 minutes. RunAtLoad catches anything pushed while the mini was
       asleep or rebooting. -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/alliegent/update.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/alliegent/update.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
