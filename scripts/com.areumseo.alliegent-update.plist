<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.areumseo.alliegent-update</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/areumseo/work/alliegent/scripts/self_update.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/areumseo/work/alliegent</string>

  <!-- Every 15 minutes. RunAtLoad catches anything pushed while the mini was
       asleep or rebooting. -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/areumseo/Library/Logs/alliegent/update.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/areumseo/Library/Logs/alliegent/update.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
