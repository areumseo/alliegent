# Copy to .env and fill in. Never commit .env — this repo is public.
# In production these are set with `fly secrets set KEY=value` instead.
#
# Keep comments on their own lines: python-dotenv does not strip trailing
# comments, so `KEY=123  # note` would read the comment as part of the value.

# --- Notion ---
# https://www.notion.so/developers/tokens -> New token -> Notion API capability
# (the old notion.so/my-integrations URL now 404s)
NOTION_TOKEN=

# Database IDs (the 32-char hex in the database's URL).
# Share each database with your integration first, or the API returns 404.
NOTION_AGENDA_DB_ID=
NOTION_PROJECTS_DB_ID=
# The 🥕 Karrot sales database. Leave blank to switch the feature off.
NOTION_KARROT_DB_ID=
# Weekly asset snapshots. Leave blank to switch the feature off.
NOTION_ASSETS_DB_ID=
# English lesson review. All four, or none.
NOTION_ENGLISH_LESSONS_DB_ID=
NOTION_ENGLISH_EXPRESSIONS_DB_ID=
NOTION_ENGLISH_MISTAKES_DB_ID=
NOTION_ENGLISH_REVIEWS_DB_ID=

# --- Anthropic ---
# https://platform.claude.com -> API keys. Powers the daily AI news digest;
# leave blank and that one job is skipped, everything else still runs.
ANTHROPIC_API_KEY=

# --- Calendar (optional) ---
# Read-only: events appear in the daily brief, nothing is written back.
#
# Preferred: CalDAV. Nothing is published, and the password can be revoked on
# its own. Generate one at appleid.apple.com -> Sign-In and Security ->
# App-Specific Passwords. Use your Apple ID email as the username.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# Optional: read only these calendars, by the name shown in the Calendar app,
# comma-separated. Leave blank to read all of them.
ICLOUD_CALENDARS=

# Which calendar new events go into when you ask the bot to create one.
# No default on purpose: writing into whichever calendar came back first
# is not a guess worth making on a real calendar. Blank means no writing.
ICLOUD_WRITE_CALENDAR=

# Fallback: ICS subscription links, comma-separated. Only used when the CalDAV
# settings above are blank.
#
# These links are unauthenticated — anyone holding one can read that calendar,
# and an iCloud one can only be revoked by unpublishing the calendar. Prefer
# CalDAV above.
CALENDAR_ICS_URLS=

# --- Discord ---
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# Server ID. Slash commands register instantly when scoped to one server;
# global registration can take up to an hour.
DISCORD_GUILD_ID=

# Per-job destination channels. Anything left blank falls back to
# DISCORD_CHANNEL_ID, and DISCORD_REVIEW_CHANNEL_ID falls back to the agenda
# channel. Right-click a channel -> Copy Channel ID (needs Developer Mode on).

# Fallback for any channel left blank below.
DISCORD_CHANNEL_ID=

# Daily brief, evening incomplete alert, week scaffolding.
DISCORD_AGENDA_CHANNEL_ID=

# Stale project nudges.
DISCORD_PROJECTS_CHANNEL_ID=

# Weekly review. Optional.
DISCORD_REVIEW_CHANNEL_ID=

# Daily AI news digest.
DISCORD_NEWS_CHANNEL_ID=
DISCORD_KARROT_CHANNEL_ID=
DISCORD_ASSETS_CHANNEL_ID=
DISCORD_ENGLISH_CHANNEL_ID=

# Optional: also send the AI news digest by email. Leave AI_NEWS_EMAIL_TO
# blank to keep the digest in Discord only. With Gmail, SMTP_PASSWORD is an
# app password from myaccount.google.com/apppasswords, not the account
# password -- Google rejects the account password over SMTP.
AI_NEWS_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
