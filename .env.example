# Copy to .env and fill in. Never commit .env — this repo is public.
# In production these are set with `fly secrets set KEY=value` instead.

# --- Notion ---
# https://www.notion.so/my-integrations -> New integration -> Internal Integration Secret
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database IDs (the 32-char hex in the DB's URL).
# Share each database with your integration first, or the API returns 404.
NOTION_AGENDA_DB_ID=
NOTION_PROJECTS_DB_ID=

# --- Discord ---
# https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Right-click the target channel -> Copy Channel ID (needs Developer Mode on)
DISCORD_CHANNEL_ID=
# Optional: restrict slash commands to this guild for instant registration
DISCORD_GUILD_ID=
